# Stratum Clinical Edge - Environment Configuration
# Copy this file to .env.local for local development

# ------------------------------------------------------------------------------
# 1. Gemini AI API Key (Server-side diagnostics generation)
# ------------------------------------------------------------------------------
# Required for server-side AI reasoning & diagnostic assistance (/api/gemini/*)
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 2. Firebase Client Configuration (Standalone Deployment)
# ------------------------------------------------------------------------------
# If deploying outside Google AI Studio, set these environment variables in your
# hosting provider (Vercel, Railway, Cloud Run, Docker, AWS, etc.).
# If unset, the app will fallback to firebase-applet-config.json if present.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_FIRESTORE_DATABASE_ID=

# ------------------------------------------------------------------------------
# 3. Security & App Check (Optional)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# ------------------------------------------------------------------------------
# 4. Port & Networking
# ------------------------------------------------------------------------------
PORT=3000
HOSTNAME=0.0.0.0

